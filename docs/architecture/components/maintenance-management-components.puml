@startuml
!include <C4/C4_Component>

title MaquiControl - Maintenance Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Maintenance Management Bounded Context") {

    Component(controller0, "MaintenancesController", "Spring Boot @RestController", "Exposes /api/v1/maintenances endpoints and maps resources to commands and queries.")
    Component(controller1, "BreakdownReportsController", "Spring Boot @RestController", "Exposes /api/v1/breakdown-reports endpoints and maps resources to commands and queries.")
    Component(commandService, "MaintenanceManagementCommandService", "Spring Boot @Service", "Handles ScheduleMaintenanceCommand, StartMaintenanceCommand, CompleteMaintenanceCommand, ReportBreakdownCommand.")
    Component(queryService, "MaintenanceManagementQueryService", "Spring Boot @Service", "Handles ViewMaintenanceScheduleQuery, ViewBreakdownReportsQuery, ViewMaintenanceHistoryQuery.")
    Component(eventHandler0, "MaintenanceEventHandler", "Spring @EventListener", "Reacts to Breakdown Reported and Worked Hours Validated and executes ScheduleMaintenanceCommand.")
    Component(domain, "Domain Model", "Java", "Maintenance aggregate, BreakdownReport entity, Money and TechnicianName value objects.")
    Component(repository, "MaintenanceRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
}

ContainerDb(database, "Database", "Relational Database", "Stores maintenances and breakdown reports.")

Rel(webapp, controller0, "Calls /api/v1/maintenances", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(webapp, controller1, "Calls /api/v1/breakdown-reports", "HTTPS / JSON")
Rel(controller1, commandService, "Sends commands")
Rel(controller1, queryService, "Sends queries")
Rel(eventHandler0, commandService, "Sends ScheduleMaintenanceCommand")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
