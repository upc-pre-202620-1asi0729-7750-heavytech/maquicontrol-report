@startuml
!include <C4/C4_Component>

title MaquiControl - Fleet Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Fleet Management Bounded Context") {

    Component(controller0, "MachineryController", "Spring Boot @RestController", "Exposes /api/v1/machinery endpoints and maps resources to commands and queries.")
    Component(controller1, "CategoriesController", "Spring Boot @RestController", "Exposes /api/v1/categories endpoints and maps resources to commands and queries.")
    Component(commandService, "FleetManagementCommandService", "Spring Boot @Service", "Handles RegisterMachineryCommand, UpdateMachineryCommand, ChangeMachineryStatusCommand, DeleteMachineryCommand, CreateCategoryCommand, RenameCategoryCommand, DeleteCategoryCommand.")
    Component(queryService, "FleetManagementQueryService", "Spring Boot @Service", "Handles ViewMachineryCatalogQuery, CheckMachineryAvailabilityQuery, ViewCategoriesQuery.")
    Component(eventHandler0, "FleetEventHandler", "Spring @EventListener", "Reacts to Reservation Confirmed, Reservation Cancelled, Maintenance Started and Maintenance Completed and executes ChangeMachineryStatusCommand.")
    Component(domain, "Domain Model", "Java", "Machinery and Category aggregates, MachinerySpecification, MachineryLocation and Money value objects.")
    Component(repository, "MachineryRepository and CategoryRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
}

ContainerDb(database, "Database", "Relational Database", "Stores categories, machinery and machinery locations.")

Rel(webapp, controller0, "Calls /api/v1/machinery", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(webapp, controller1, "Calls /api/v1/categories", "HTTPS / JSON")
Rel(controller1, commandService, "Sends commands")
Rel(controller1, queryService, "Sends queries")
Rel(eventHandler0, commandService, "Sends ChangeMachineryStatusCommand")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
