@startuml
!include <C4/C4_Component>

title MaquiControl - Subscription Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Subscription Management Bounded Context") {

    Component(controller0, "PlansController", "Spring Boot @RestController", "Exposes /api/v1/plans endpoints and maps resources to commands and queries.")
    Component(controller1, "SubscriptionsController", "Spring Boot @RestController", "Exposes /api/v1/subscriptions endpoints and maps resources to commands and queries.")
    Component(commandService, "SubscriptionManagementCommandService", "Spring Boot @Service", "Handles SubscribeToPlanCommand, ConfirmCheckoutCommand, ActivateSubscriptionCommand, CancelSubscriptionCommand.")
    Component(queryService, "SubscriptionManagementQueryService", "Spring Boot @Service", "Handles ViewPlansQuery, ViewSubscriptionQuery, ViewPaymentsQuery.")
    Component(eventHandler0, "SubscriptionEventHandler", "Spring @EventListener", "Reacts to Subscription Payment Approved and executes ActivateSubscriptionCommand.")
    Component(domain, "Domain Model", "Java", "Subscription aggregate, SubscriptionPlan and Payment entities, Money and MachineryLimit value objects.")
    Component(repository, "SubscriptionRepository and SubscriptionPlanRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
    Component(mercadoPagoAcl, "MercadoPagoService", "Spring @Service (Anti-Corruption Layer)", "Translates requests and responses of Mercado Pago.")
}

System_Ext(mercadoPago, "Mercado Pago", "Checkout Pro payment provider (sandbox).")
ContainerDb(database, "Database", "Relational Database", "Stores subscription plans, subscriptions and payments.")

Rel(webapp, controller0, "Calls /api/v1/plans", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(webapp, controller1, "Calls /api/v1/subscriptions", "HTTPS / JSON")
Rel(controller1, commandService, "Sends commands")
Rel(controller1, queryService, "Sends queries")
Rel(eventHandler0, commandService, "Sends ActivateSubscriptionCommand")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(commandService, mercadoPagoAcl, "Uses")
Rel(mercadoPagoAcl, mercadoPago, "Creates checkout preferences and reads payments", "HTTPS / JSON")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
