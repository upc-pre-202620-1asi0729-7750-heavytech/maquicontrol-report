@startuml
!include <C4/C4_Component>

title MaquiControl - Profiles Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Profiles Management Bounded Context") {

    Component(controller0, "ProfilesController", "Spring Boot @RestController", "Exposes /api/v1/profiles endpoints and maps resources to commands and queries.")
    Component(controller1, "OrganizationsController", "Spring Boot @RestController", "Exposes /api/v1/organizations endpoints and maps resources to commands and queries.")
    Component(commandService, "ProfilesManagementCommandService", "Spring Boot @Service", "Handles CreateProfileCommand, UpdateProfileCommand, CreateOrganizationCommand, UpdateOrganizationCommand.")
    Component(queryService, "ProfilesManagementQueryService", "Spring Boot @Service", "Handles ViewProfileQuery, ViewOrganizationQuery.")
    Component(eventHandler0, "ProfilesEventHandler", "Spring @EventListener", "Reacts to User Signed Up and executes CreateProfileCommand.")
    Component(domain, "Domain Model", "Java", "Profile aggregate, Organization entity, ContactInformation, PersonName and TaxId value objects.")
    Component(repository, "ProfileRepository and OrganizationRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
}

ContainerDb(database, "Database", "Relational Database", "Stores profiles, contact information and organizations.")

Rel(webapp, controller0, "Calls /api/v1/profiles", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(webapp, controller1, "Calls /api/v1/organizations", "HTTPS / JSON")
Rel(controller1, commandService, "Sends commands")
Rel(controller1, queryService, "Sends queries")
Rel(eventHandler0, commandService, "Sends CreateProfileCommand")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
