@startuml
!include <C4/C4_Component>


title MaquiControl - Operations Management Bounded Context Component Diagram\n<size:12>Layers and packages of the bounded context</size>

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Operations Management Bounded Context") {

  Boundary(interfaces, "interfaces") {
    Component(rest, "interfaces.rest", "Java package", "Controllers that expose /api/v1/service-operations, with the resources and transform subpackages that map JSON to commands and queries.")
    Component(ifacl, "interfaces.acl", "Java package", "Context facade that other bounded contexts use to read completed operations and validated hours.")
    Component(ifevents, "interfaces.events", "Java package", "Integration events published to other bounded contexts: Operation Started, Worked Hours Validated and Operation Completed.")
  }
  Boundary(application, "application") {
    Component(cs, "application.commandservices", "Java package", "Command service contract for Start Operation, Record Worked Hours, Validate Worked Hours, Reject Worked Hours and Complete Operation.")
    Component(qs, "application.queryservices", "Java package", "Query service contract for View Service Operation and View Worked Hours.")
    Component(ics, "application.internal.commandservices", "Java package", "Command service implementation: loads the aggregate, runs its behavior and saves it, returning a Result.")
    Component(iqs, "application.internal.queryservices", "Java package", "Query service implementation that reads aggregates through the repositories.")
    Component(ieh, "application.internal.eventhandlers", "Java package", "Translate Operations domain events into integration events.")
    Component(iob, "application.internal.outboundservices", "Java package", "Anti-corruption layer that reads confirmed rentals from Rental Management and machinery owners from Fleet Management.")
    Component(appacl, "application.acl", "Java package", "Implementation of the context facade on top of the query services.")
  }
  Boundary(domain, "domain") {
    Component(dagg, "domain.model.aggregates", "Java package", "Aggregate roots: ServiceOperation.")
    Component(dent, "domain.model.entities", "Java package", "Entities inside the aggregates: WorkedHours.")
    Component(dvo, "domain.model.valueobjects", "Java package", "Value objects and enums of the bounded context.")
    Component(dcmd, "domain.model.commands", "Java package", "One record per command: Start Operation, Record Worked Hours, Validate Worked Hours, Reject Worked Hours and Complete Operation.")
    Component(dqry, "domain.model.queries", "Java package", "One record per query: View Service Operation and View Worked Hours.")
    Component(devt, "domain.model.events", "Java package", "Domain events registered by the aggregates.")
    Component(drep, "domain.repositories", "Java package", "Repository interfaces of the aggregates, without JPA details.")
  }
  Boundary(infrastructure, "infrastructure") {
    Component(jad, "infrastructure.persistence.jpa.adapters", "Java package", "Implement the domain repositories and publish the aggregate events to the outbox.")
    Component(jas, "infrastructure.persistence.jpa.assemblers", "Java package", "Convert between aggregates and persistence entities.")
    Component(jen, "infrastructure.persistence.jpa.entities", "Java package", "JPA persistence entities mapped to the tables.")
    Component(jre, "infrastructure.persistence.jpa.repositories", "Java package", "Spring Data JPA repositories.")
  }
}

Component(shared, "shared", "Java package", "Shared kernel: Result, ApplicationError, Money, base aggregate and the outbox relay.")
Component(rentalacl, "rental.interfaces.acl", "Java package", "Context facade of another bounded context.")
Component(fleetacl, "fleet.interfaces.acl", "Java package", "Context facade of another bounded context.")
ContainerDb(database, "Database", "MySQL", "Stores service operations and worked hours.")

Rel_D(webapp, rest, "Calls /api/v1/service-operations", "HTTPS / JSON")
Rel_D(rest, cs, "Sends commands")
Rel_D(rest, qs, "Sends queries")
Rel_D(ics, dagg, "Runs aggregate behavior")
Rel_D(ics, drep, "Saves aggregates")
Rel_D(iqs, drep, "Reads aggregates")
Rel_U(jad, drep, "Implements")
Rel_R(jad, jre, "Uses")
Rel_D(jre, database, "Reads from and writes to", "JPA / SQL")
rest -[hidden]down-> ics
ics -[hidden]down-> dagg
dagg -[hidden]down-> jad
jad -[hidden]down-> shared
Rel_L(ieh, cs, "Sends commands")
Rel_U(appacl, ifacl, "Implements")
Rel_D(iob, rentalacl, "Calls")
Rel_D(iob, fleetacl, "Calls")


@enduml
