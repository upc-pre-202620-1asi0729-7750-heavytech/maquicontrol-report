@startuml
!include <C4/C4_Component>

title MaquiControl - Rental Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Rental Management Bounded Context") {

    Component(controller0, "RentalsController", "Spring Boot @RestController", "Exposes /api/v1/rentals endpoints and maps resources to commands and queries.")
    Component(commandService, "RentalManagementCommandService", "Spring Boot @Service", "Handles RequestRentalCommand, ConfirmReservationCommand, RejectReservationCommand, CancelReservationCommand, StartRentalCommand, CompleteRentalCommand.")
    Component(queryService, "RentalManagementQueryService", "Spring Boot @Service", "Handles ViewPendingRequestsQuery, ViewMyReservationsQuery, CheckMachineryAvailabilityQuery.")
    Component(eventHandler0, "RentalEventHandler", "Spring @EventListener", "Reacts to Operation Started and Operation Completed and executes StartRentalCommand and CompleteRentalCommand.")
    Component(domain, "Domain Model", "Java", "Rental aggregate, RentalPeriod, Money and Reason value objects.")
    Component(repository, "RentalRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
}

ContainerDb(database, "Database", "Relational Database", "Stores rentals and rental periods.")

Rel(webapp, controller0, "Calls /api/v1/rentals", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(eventHandler0, commandService, "Sends StartRentalCommand and CompleteRentalCommand")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
