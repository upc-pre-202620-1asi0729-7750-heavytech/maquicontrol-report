@startuml
!include <C4/C4_Component>

title MaquiControl - Identity & Access Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(bc, "Identity & Access Management Bounded Context") {

    Component(controller0, "AuthenticationController", "Spring Boot @RestController", "Exposes /api/v1/authentication/sign-up and /sign-in endpoints and maps resources to commands and queries.")
    Component(controller1, "UserAccountsController", "Spring Boot @RestController", "Exposes /api/v1/user-accounts and /api/v1/roles endpoints and maps resources to commands and queries.")
    Component(commandService, "IdentityAccessCommandService", "Spring Boot @Service", "Handles SignUpCommand, SignInCommand, SignOutCommand.")
    Component(queryService, "IdentityAccessQueryService", "Spring Boot @Service", "Handles GetSignedInAccountQuery, ViewRolesQuery.")
    Component(security, "SecurityFilterChain", "Spring Security Component", "Applies JwtTokenFilter to validate Bearer tokens on protected routes.")
    Component(domain, "Domain Model", "Java", "UserAccount aggregate, Role entity, Credential, EmailAddress and PasswordHash value objects.")
    Component(repository, "UserAccountRepository and RoleRepository", "Spring Data JPA @Repository", "Persists and reads the aggregates of the bounded context.")
}

ContainerDb(database, "Database", "Relational Database", "Stores user accounts, credentials, roles and their assignment.")

Rel(webapp, controller0, "Calls /api/v1/authentication/sign-up and /sign-in", "HTTPS / JSON")
Rel(controller0, commandService, "Sends commands")
Rel(controller0, queryService, "Sends queries")
Rel(webapp, controller1, "Calls /api/v1/user-accounts and /api/v1/roles", "HTTPS / JSON")
Rel(controller1, commandService, "Sends commands")
Rel(controller1, queryService, "Sends queries")
Rel(commandService, domain, "Executes aggregate behavior")
Rel(commandService, repository, "Saves aggregates")
Rel(queryService, repository, "Reads aggregates")
Rel(controller0, security, "Issues and validates JWT tokens")
Rel(repository, database, "Reads from and writes to", "JPA / SQL")

@enduml
