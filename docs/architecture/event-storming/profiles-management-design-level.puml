@startuml
title MaquiControl - Profiles Management Bounded Context\nDesign-Level Event Storming

left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam rectangleFontSize 12
skinparam ArrowColor #555555
skinparam noteBorderColor #BDB76B
skinparam nodesep 30
skinparam ranksep 40

rectangle "DOMAIN EVENT (Identity & Access)\nUser Signed Up" as XEVT_1 #FFE0B2
rectangle "POLICY\nWhen a user signs up,\nask for the profile data" as POL_2 #B39DDB
XEVT_1 --> POL_2
rectangle "COMMAND\nCreate Profile" as CMD_3 #87CEFA
rectangle "ACTOR\nUser" as ACT_4 #FFF9C4
ACT_4 -left-> CMD_3
POL_2 --> CMD_3
rectangle "AGGREGATE\nProfile" as AGG_5 #FFF59D
CMD_3 --> AGG_5
rectangle "DOMAIN EVENT\nProfile Created" as EVT_6 #FFB74D
AGG_5 --> EVT_6
rectangle "POLICY\nWhen a profile is created,\nask for its organization data" as POL_7 #B39DDB
EVT_6 --> POL_7
rectangle "COMMAND\nCreate Organization" as CMD_8 #87CEFA
rectangle "ACTOR\nUser" as ACT_9 #FFF9C4
ACT_9 -left-> CMD_8
POL_7 --> CMD_8
rectangle "AGGREGATE\nOrganization" as AGG_10 #FFF59D
CMD_8 --> AGG_10
rectangle "HOTSPOT\nThe RUC is not yet verified\nagainst SUNAT" as HOT_11 #EF9A9A
HOT_11 .right. AGG_10
rectangle "COMMAND\nUpdate Profile" as CMD_12 #87CEFA
rectangle "ACTOR\nUser" as ACT_13 #FFF9C4
ACT_13 -left-> CMD_12
rectangle "AGGREGATE\nProfile" as AGG_14 #FFF59D
CMD_12 --> AGG_14
rectangle "COMMAND\nUpdate Organization" as CMD_15 #87CEFA
rectangle "ACTOR\nUser" as ACT_16 #FFF9C4
ACT_16 -left-> CMD_15
rectangle "AGGREGATE\nOrganization" as AGG_17 #FFF59D
CMD_15 --> AGG_17
AGG_14 -[hidden]-> CMD_15
rectangle "<b>BUSINESS RULES (Profile)</b>\n- First name and last name are required\n- Document number is required\n- Contact information requires valid\n  phone, email and address" as BR_18 #FFFDE7
rectangle "<b>BUSINESS RULES (Organization)</b>\n- Legal name, tax id (RUC) and\n  address are required\n- Tax id must be valid" as BR_19 #FFFDE7
rectangle "READ MODEL\nProfile Details\n<size:10><i>Query: View Profile</i></size>\n<size:10>Source: Profile</size>" as RM_20 #81C784
rectangle "ACTOR\nUser" as ACT_21 #FFF9C4
RM_20 ..> ACT_21 : informs
rectangle "READ MODEL\nOrganization Details\n<size:10><i>Query: View Organization</i></size>\n<size:10>Source: Organization</size>" as RM_22 #81C784
rectangle "ACTOR\nUser" as ACT_23 #FFF9C4
RM_22 ..> ACT_23 : informs

' Flows are stacked from top to bottom; each one reads left to right
CMD_12 -[hidden]left-> XEVT_1
RM_20 -[hidden]left-> CMD_12
RM_22 -[hidden]left-> RM_20
ACT_21 -[hidden]-> BR_18
BR_18 -[hidden]-> BR_19

legend right
|= Color |= Element |
|<#FFF9C4>| Actor |
|<#87CEFA>| Command |
|<#FFF59D>| Aggregate |
|<#FFB74D>| Domain Event |
|<#B39DDB>| Policy |
|<#FFE0B2>| Domain Event from another Bounded Context |
|<#81C784>| Read Model |
|<#EF9A9A>| Hotspot |
|<#FFFDE7>| Business Rules |
endlegend

@enduml
