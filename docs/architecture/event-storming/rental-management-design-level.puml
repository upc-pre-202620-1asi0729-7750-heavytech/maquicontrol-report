@startuml
title MaquiControl - Rental Management Bounded Context\nDesign-Level Event Storming

left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam rectangleFontSize 12
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #BDB76B
skinparam ArrowColor #555555

' ===== Actor -> Command -> Aggregate -> Domain Event =====
rectangle "COMMAND\nRequest Rental" as CMD_REQUEST_RENTAL #87CEFA
rectangle "AGGREGATE\nRental" as AGG_RENTAL_0 #FFF59D
rectangle "DOMAIN EVENT\nRental Requested" as EVT_RENTAL_REQUESTED #FFB74D
rectangle "ACTOR\nContractor" as ACT_CONTRACTOR_0 #FFF9C4
rectangle "COMMAND\nConfirm Reservation" as CMD_CONFIRM_RESERVATION #87CEFA
rectangle "AGGREGATE\nRental" as AGG_RENTAL_1 #FFF59D
rectangle "DOMAIN EVENT\nReservation Confirmed" as EVT_RESERVATION_CONFIRMED #FFB74D
rectangle "ACTOR\nFleet Owner" as ACT_FLEET_OWNER_1 #FFF9C4
rectangle "COMMAND\nCancel Reservation" as CMD_CANCEL_RESERVATION #87CEFA
rectangle "AGGREGATE\nRental" as AGG_RENTAL_2 #FFF59D
rectangle "DOMAIN EVENT\nReservation Cancelled" as EVT_RESERVATION_CANCELLED #FFB74D
rectangle "ACTOR\nContractor" as ACT_CONTRACTOR_2 #FFF9C4
rectangle "COMMAND\nStart Rental" as CMD_START_RENTAL #87CEFA
rectangle "AGGREGATE\nRental" as AGG_RENTAL_3 #FFF59D
rectangle "DOMAIN EVENT\nRental Started" as EVT_RENTAL_STARTED #FFB74D
rectangle "COMMAND\nComplete Rental" as CMD_COMPLETE_RENTAL #87CEFA
rectangle "AGGREGATE\nRental" as AGG_RENTAL_4 #FFF59D
rectangle "DOMAIN EVENT\nRental Completed" as EVT_RENTAL_COMPLETED #FFB74D

' ===== Policies =====
rectangle "DOMAIN EVENT (Operations)\nService Operation Started" as XEVT_SERVICE_OPERATION_STARTED #FFE0B2
rectangle "POLICY\nWhen the service operation starts,\nmark the rental as IN_PROGRESS" as POL_0 #B39DDB
rectangle "DOMAIN EVENT (Operations)\nService Operation Completed" as XEVT_SERVICE_OPERATION_COMPLETED #FFE0B2
rectangle "POLICY\nWhen the service operation is completed,\nmark the rental as COMPLETED" as POL_1 #B39DDB

' ===== Read Models =====
rectangle "READ MODEL\nPending Rental Requests\n<size:10><i>Query: View Pending Requests</i></size>" as RM_0 #81C784
rectangle "ACTOR\nFleet Owner" as ACT_RM_0 #FFF9C4
rectangle "READ MODEL\nMy Reservations\n<size:10><i>Query: View My Reservations</i></size>" as RM_1 #81C784
rectangle "ACTOR\nContractor" as ACT_RM_1 #FFF9C4
rectangle "READ MODEL\nMachinery Availability (Fleet)\n<size:10><i>Query: Check Machinery Availability</i></size>" as RM_2 #81C784
rectangle "ACTOR\nContractor" as ACT_RM_2 #FFF9C4
rectangle "HOTSPOT\nTwo contractors may request the same\nmachinery for overlapping dates" as HOT_0 #EF9A9A

ACT_CONTRACTOR_0 --> CMD_REQUEST_RENTAL
CMD_REQUEST_RENTAL --> AGG_RENTAL_0
AGG_RENTAL_0 --> EVT_RENTAL_REQUESTED
note bottom of AGG_RENTAL_0
<b>Business rules (Rental)</b>
- Rental period end date cannot be
  before its start date
- Machinery cannot have overlapping
  active rentals
- Valid transitions: REQUESTED -> CONFIRMED
  -> IN_PROGRESS -> COMPLETED
- Only REQUESTED or CONFIRMED rentals
  can be cancelled
- Total amount (Money) cannot be negative
- A cancelled rental records its cancellation date
end note
ACT_FLEET_OWNER_1 --> CMD_CONFIRM_RESERVATION
CMD_CONFIRM_RESERVATION --> AGG_RENTAL_1
AGG_RENTAL_1 --> EVT_RESERVATION_CONFIRMED
ACT_CONTRACTOR_2 --> CMD_CANCEL_RESERVATION
CMD_CANCEL_RESERVATION --> AGG_RENTAL_2
AGG_RENTAL_2 --> EVT_RESERVATION_CANCELLED
CMD_START_RENTAL --> AGG_RENTAL_3
AGG_RENTAL_3 --> EVT_RENTAL_STARTED
CMD_COMPLETE_RENTAL --> AGG_RENTAL_4
AGG_RENTAL_4 --> EVT_RENTAL_COMPLETED
XEVT_SERVICE_OPERATION_STARTED --> POL_0
POL_0 --> CMD_START_RENTAL
XEVT_SERVICE_OPERATION_COMPLETED --> POL_1
POL_1 --> CMD_COMPLETE_RENTAL
EVT_RENTAL_REQUESTED ..> RM_0 : updates
EVT_RESERVATION_CONFIRMED ..> RM_0 : updates
EVT_RESERVATION_CANCELLED ..> RM_0 : updates
RM_0 ..> ACT_RM_0 : informs
EVT_RENTAL_REQUESTED ..> RM_1 : updates
EVT_RESERVATION_CONFIRMED ..> RM_1 : updates
EVT_RESERVATION_CANCELLED ..> RM_1 : updates
EVT_RENTAL_STARTED ..> RM_1 : updates
EVT_RENTAL_COMPLETED ..> RM_1 : updates
RM_1 ..> ACT_RM_1 : informs
RM_2 ..> ACT_RM_2 : informs
HOT_0 .. EVT_RENTAL_REQUESTED

legend right
|= Color |= Element |
|<#FFF9C4>| Actor |
|<#87CEFA>| Command |
|<#FFF59D>| Aggregate |
|<#FFB74D>| Domain Event |
|<#B39DDB>| Policy |
|<#81C784>| Read Model |
|<#FFE0B2>| Domain Event from another Bounded Context |
|<#EF9A9A>| Hotspot |
|<#FFFDE7>| Business Rules (note) |
endlegend

@enduml
