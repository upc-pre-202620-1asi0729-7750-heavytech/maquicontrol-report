@startuml
title MaquiControl - Subscription Management Bounded Context\nDesign-Level Event Storming

left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam rectangleFontSize 12
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #BDB76B
skinparam ArrowColor #555555

' ===== Actor -> Command -> Aggregate -> Domain Event =====
rectangle "COMMAND\nSubscribe to Plan" as CMD_SUBSCRIBE_TO_PLAN #87CEFA
rectangle "AGGREGATE\nSubscription" as AGG_SUBSCRIPTION_0 #FFF59D
rectangle "DOMAIN EVENT\nSubscription Requested" as EVT_SUBSCRIPTION_REQUESTED #FFB74D
rectangle "ACTOR\nFleet Owner" as ACT_FLEET_OWNER_0 #FFF9C4
rectangle "COMMAND\nConfirm Checkout" as CMD_CONFIRM_CHECKOUT #87CEFA
rectangle "AGGREGATE\nSubscription" as AGG_SUBSCRIPTION_1 #FFF59D
rectangle "DOMAIN EVENT\nSubscription Payment Approved" as EVT_SUBSCRIPTION_PAYMENT_APPROVED #FFB74D
rectangle "COMMAND\nActivate Subscription" as CMD_ACTIVATE_SUBSCRIPTION #87CEFA
rectangle "AGGREGATE\nSubscription" as AGG_SUBSCRIPTION_2 #FFF59D
rectangle "DOMAIN EVENT\nSubscription Activated" as EVT_SUBSCRIPTION_ACTIVATED #FFB74D
rectangle "COMMAND\nCancel Subscription" as CMD_CANCEL_SUBSCRIPTION #87CEFA
rectangle "AGGREGATE\nSubscription" as AGG_SUBSCRIPTION_3 #FFF59D
rectangle "DOMAIN EVENT\nSubscription Cancelled" as EVT_SUBSCRIPTION_CANCELLED #FFB74D
rectangle "ACTOR\nFleet Owner" as ACT_FLEET_OWNER_3 #FFF9C4

' ===== Policies =====
rectangle "POLICY\nWhen a plan is selected,\nredirect the owner to the checkout" as POL_0 #B39DDB
rectangle "POLICY\nWhen the payment is approved,\nactivate the subscription" as POL_1 #B39DDB

' ===== Read Models =====
rectangle "READ MODEL\nPlan Catalog\n<size:10><i>Query: View Plans</i></size>" as RM_0 #81C784
rectangle "ACTOR\nFleet Owner" as ACT_RM_0 #FFF9C4
rectangle "READ MODEL\nSubscription Status\n<size:10><i>Query: View Subscription</i></size>" as RM_1 #81C784
rectangle "ACTOR\nFleet Owner" as ACT_RM_1 #FFF9C4
rectangle "READ MODEL\nPayment History\n<size:10><i>Query: View Payments</i></size>" as RM_2 #81C784
rectangle "ACTOR\nFleet Owner" as ACT_RM_2 #FFF9C4
rectangle "EXTERNAL SYSTEM\nMercado Pago\nCheckout Pro (sandbox)" as EXT_0 #E78AD9
rectangle "HOTSPOT\nThe payment may be approved but\nthe owner never returns to the app" as HOT_0 #EF9A9A

ACT_FLEET_OWNER_0 --> CMD_SUBSCRIBE_TO_PLAN
CMD_SUBSCRIBE_TO_PLAN --> AGG_SUBSCRIPTION_0
AGG_SUBSCRIPTION_0 --> EVT_SUBSCRIPTION_REQUESTED
note bottom of AGG_SUBSCRIPTION_0
<b>Business rules (Subscription)</b>
- Plan price must be greater than zero
- Plan machinery limit is a positive integer
- Only a subscription PENDING_PAYMENT
  can be activated
- An active subscription records its
  payment and period
end note
CMD_CONFIRM_CHECKOUT --> AGG_SUBSCRIPTION_1
AGG_SUBSCRIPTION_1 --> EVT_SUBSCRIPTION_PAYMENT_APPROVED
CMD_ACTIVATE_SUBSCRIPTION --> AGG_SUBSCRIPTION_2
AGG_SUBSCRIPTION_2 --> EVT_SUBSCRIPTION_ACTIVATED
ACT_FLEET_OWNER_3 --> CMD_CANCEL_SUBSCRIPTION
CMD_CANCEL_SUBSCRIPTION --> AGG_SUBSCRIPTION_3
AGG_SUBSCRIPTION_3 --> EVT_SUBSCRIPTION_CANCELLED
EVT_SUBSCRIPTION_REQUESTED --> POL_0
POL_0 --> CMD_CONFIRM_CHECKOUT
EVT_SUBSCRIPTION_PAYMENT_APPROVED --> POL_1
POL_1 --> CMD_ACTIVATE_SUBSCRIPTION
RM_0 ..> ACT_RM_0 : informs
EVT_SUBSCRIPTION_ACTIVATED ..> RM_1 : updates
EVT_SUBSCRIPTION_CANCELLED ..> RM_1 : updates
RM_1 ..> ACT_RM_1 : informs
EVT_SUBSCRIPTION_PAYMENT_APPROVED ..> RM_2 : updates
RM_2 ..> ACT_RM_2 : informs
CMD_CONFIRM_CHECKOUT .. EXT_0
HOT_0 .. EVT_SUBSCRIPTION_PAYMENT_APPROVED

legend right
|= Color |= Element |
|<#FFF9C4>| Actor |
|<#87CEFA>| Command |
|<#FFF59D>| Aggregate |
|<#FFB74D>| Domain Event |
|<#B39DDB>| Policy |
|<#81C784>| Read Model |
|<#E78AD9>| External System |
|<#EF9A9A>| Hotspot |
|<#FFFDE7>| Business Rules (note) |
endlegend

@enduml
