@startuml
title MaquiControl - Maintenance Management Bounded Context\nGeneral Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Maintenance Management" {

  class Maintenance <<Aggregate Root>> {
    - id: MaintenanceId
    - machineryId: MachineryId
    - type: MaintenanceType
    - status: MaintenanceStatus
    - description: Description
    - scheduledDate: LocalDateTime
    - startedAt: LocalDateTime
    - completedAt: LocalDateTime
    - technicianName: TechnicianName
    - cost: Money
    - breakdownReports: List<BreakdownReport>
    + start(technicianName: TechnicianName): void
    + complete(cost: Money): void
    + reportBreakdown(report: BreakdownReport): void
    + isPending(): Boolean
  }

  class BreakdownReport <<Entity>> {
    - id: BreakdownReportId
    - description: Description
    - severity: BreakdownSeverity
    - reportedAt: LocalDateTime
    - resolvedAt: LocalDateTime
    - status: BreakdownStatus
    + resolve(): void
    + isCritical(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum MaintenanceType {
    PREVENTIVE
    CORRECTIVE
    INSPECTION
  }

  enum MaintenanceStatus {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  enum BreakdownSeverity {
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }

  interface MaintenanceRepository {
    + save(maintenance: Maintenance): Maintenance
    + findById(id: MaintenanceId): Optional<Maintenance>
    + findByMachineryId(machineryId: MachineryId): List<Maintenance>
    + findByStatus(status: MaintenanceStatus): List<Maintenance>
    + findCompletedByMachineryId(machineryId: MachineryId): List<Maintenance>
  }

  class MaintenanceManagementCommandService <<Application Service>> {
    - maintenanceRepository: MaintenanceRepository
    + handle(command: ScheduleMaintenanceCommand): Optional<Maintenance>
    + handle(command: StartMaintenanceCommand): Optional<Maintenance>
    + handle(command: CompleteMaintenanceCommand): Optional<Maintenance>
    + handle(command: ReportBreakdownCommand): Optional<Maintenance>
  }

  class MaintenanceManagementQueryService <<Application Service>> {
    - maintenanceRepository: MaintenanceRepository
    + handle(query: ViewMaintenanceScheduleQuery): List<Maintenance>
    + handle(query: ViewBreakdownReportsQuery): List<BreakdownReport>
    + handle(query: ViewMaintenanceHistoryQuery): List<Maintenance>
  }

  package "Commands" {
    class ScheduleMaintenanceCommand <<Command>> {
      - machineryId: MachineryId
      - type: MaintenanceType
      - description: Description
      - scheduledDate: LocalDate
    }
    class StartMaintenanceCommand <<Command>> {
      - maintenanceId: MaintenanceId
      - technicianName: TechnicianName
    }
    class CompleteMaintenanceCommand <<Command>> {
      - maintenanceId: MaintenanceId
      - cost: Money
    }
    class ReportBreakdownCommand <<Command>> {
      - machineryId: MachineryId
      - severity: BreakdownSeverity
      - description: Description
    }
  }

  package "Queries" {
    class ViewMaintenanceScheduleQuery <<Query>> {
      - ownerProfileId: ProfileId
    }
    class ViewBreakdownReportsQuery <<Query>> {
      - machineryId: MachineryId
    }
    class ViewMaintenanceHistoryQuery <<Query>> {
      - machineryId: MachineryId
    }
  }

  class Description <<Value Object>> {
    - value: String
    + isEmpty(): Boolean
  }

  class TechnicianName <<Value Object>> {
    - value: String
  }

  enum BreakdownStatus {
    OPEN
    RESOLVED
  }

  package "Identifiers" {
    class ProfileId <<Value Object>> {
      - value: Long
    }
    class BreakdownReportId <<Value Object>> {
      - value: Long
    }
    class MachineryId <<Value Object>> {
      - value: Long
    }
    class MaintenanceId <<Value Object>> {
      - value: Long
    }
  }
}

Maintenance "1" *-- "0..*" BreakdownReport : contains >
Maintenance "1" *-- "0..1" Money : cost >
Money --> Currency : expressed in >
Maintenance --> MaintenanceType : classified as >
Maintenance --> MaintenanceStatus : has >
BreakdownReport --> BreakdownSeverity : has >
MaintenanceManagementCommandService "1" --> "1" MaintenanceRepository : uses >
MaintenanceManagementQueryService "1" --> "1" MaintenanceRepository : uses >
MaintenanceRepository ..> Maintenance : persists >

Maintenance "1" *-- "1" Description : description >
Maintenance "1" *-- "1" TechnicianName : technicianName >
BreakdownReport "1" *-- "1" Description : description >
BreakdownReport --> BreakdownStatus : status >

MaintenanceManagementCommandService "1" ..> "1" ScheduleMaintenanceCommand : handles >
MaintenanceManagementCommandService "1" ..> "1" StartMaintenanceCommand : handles >
MaintenanceManagementCommandService "1" ..> "1" CompleteMaintenanceCommand : handles >
MaintenanceManagementCommandService "1" ..> "1" ReportBreakdownCommand : handles >
MaintenanceManagementQueryService "1" ..> "1" ViewMaintenanceScheduleQuery : handles >
MaintenanceManagementQueryService "1" ..> "1" ViewBreakdownReportsQuery : handles >
MaintenanceManagementQueryService "1" ..> "1" ViewMaintenanceHistoryQuery : handles >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend


@enduml
