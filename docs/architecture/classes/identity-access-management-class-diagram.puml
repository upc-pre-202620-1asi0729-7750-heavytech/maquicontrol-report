@startuml
title MaquiControl - Identity & Access Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Identity & Access Management" {

  class UserAccount <<Aggregate Root>> {
    - id: UserAccountId
    - email: EmailAddress
    - credential: Credential
    - status: AccountStatus
    - roles: Set<Role>
    - createdAt: LocalDateTime
    - lastLoginAt: LocalDateTime
    + register(): void
    + authenticate(rawPassword: PlainPassword): Boolean
    + assignRole(role: Role): void
    + removeRole(role: Role): void
    + changePassword(passwordHash: PasswordHash): void
    + activate(): void
    + suspend(): void
    + hasRole(roleName: RoleName): Boolean
  }

  class Credential <<Value Object>> {
    - passwordHash: PasswordHash
    - changedAt: LocalDateTime
    + matches(rawPassword: PlainPassword): Boolean
    + update(passwordHash: PasswordHash): Credential
  }

  class Role <<Entity>> {
    - id: RoleId
    - name: RoleName
    - description: Description
    + isAdministrative(): Boolean
  }

  enum AccountStatus {
    PENDING
    ACTIVE
    SUSPENDED
    DISABLED
  }

  enum RoleName {
    CONTRACTOR
    FLEET_OWNER
    FLEET_ADMINISTRATOR
    OPERATOR
    SYSTEM_ADMINISTRATOR
  }

  interface UserAccountRepository {
    + save(account: UserAccount): UserAccount
    + findById(id: UserAccountId): Optional<UserAccount>
    + findByEmail(email: EmailAddress): Optional<UserAccount>
    + existsByEmail(email: EmailAddress): Boolean
  }

  class IdentityAccessService <<Application Service>> {
    - accountRepository: UserAccountRepository
    + registerUser(account: UserAccount): UserAccount
    + authenticateUser(email: EmailAddress, password: PlainPassword): UserAccount
    + assignRole(accountId: UserAccountId, role: Role): UserAccount
    + changePassword(accountId: UserAccountId, passwordHash: PasswordHash): UserAccount
    + viewAccountDetails(accountId: UserAccountId): UserAccount
    + viewUserRoles(accountId: UserAccountId): Set<Role>
    + checkAuthenticationStatus(accountId: UserAccountId): AccountStatus
  }

  class EmailAddress <<Value Object>> {
    - value: String
    + isValid(): Boolean
  }

  class PasswordHash <<Value Object>> {
    - value: String
  }

  class PlainPassword <<Value Object>> {
    - value: String
    + meetsPolicy(): Boolean
  }

  class Description <<Value Object>> {
    - value: String
    + isEmpty(): Boolean
  }

  package "Identifiers" {
    class RoleId <<Value Object>> {
      - value: Long
    }
    class UserAccountId <<Value Object>> {
      - value: Long
    }
  }
}

UserAccount "1" *-- "1" Credential : owns >
UserAccount "1" o-- "1..*" Role : has >
UserAccount --> AccountStatus : has >
Role --> RoleName : identified by >
IdentityAccessService "1" --> "1" UserAccountRepository : uses >
UserAccountRepository ..> UserAccount : persists >

UserAccount "1" *-- "1" EmailAddress : email >
Credential "1" *-- "1" PasswordHash : passwordHash >
Role "1" *-- "1" Description : description >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | o-- | Aggregation |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
