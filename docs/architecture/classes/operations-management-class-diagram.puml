@startuml
title MaquiControl - Operations Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Operations Management" {

  class ServiceOperation <<Aggregate Root>> {
    - id: ServiceOperationId
    - rentalId: RentalId
    - machineryId: MachineryId
    - operatorProfileId: ProfileId
    - status: OperationStatus
    - startedAt: LocalDateTime
    - completedAt: LocalDateTime
    - workedHours: List<WorkedHours>
    + start(): void
    + recordWorkedHours(record: WorkedHours): void
    + validateWorkedHours(recordId: WorkedHoursId): void
    + complete(): void
    + calculateTotalHours(): HoursWorked
    + isInProgress(): Boolean
  }

  class WorkedHours <<Entity>> {
    - id: WorkedHoursId
    - shift: WorkShift
    - totalHours: HoursWorked
    - status: WorkedHoursStatus
    - observations: Notes
    + calculateHours(): HoursWorked
    + validate(): void
    + reject(): void
    + isValidated(): Boolean
  }

  enum OperationStatus {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  enum WorkedHoursStatus {
    PENDING
    VALIDATED
    REJECTED
  }

  interface ServiceOperationRepository {
    + save(operation: ServiceOperation): ServiceOperation
    + findById(id: ServiceOperationId): Optional<ServiceOperation>
    + findByRentalId(rentalId: RentalId): Optional<ServiceOperation>
    + findByMachineryId(machineryId: MachineryId): List<ServiceOperation>
    + findByStatus(status: OperationStatus): List<ServiceOperation>
  }

  class OperationsManagementService <<Application Service>> {
    - operationRepository: ServiceOperationRepository
    + startService(operation: ServiceOperation): ServiceOperation
    + recordWorkedHours(operationId: ServiceOperationId, record: WorkedHours): ServiceOperation
    + validateWorkedHours(operationId: ServiceOperationId, recordId: WorkedHoursId): ServiceOperation
    + completeService(id: ServiceOperationId): ServiceOperation
    + viewServiceStatus(id: ServiceOperationId): OperationStatus
    + viewWorkedHours(id: ServiceOperationId): List<WorkedHours>
    + viewOperationHistory(machineryId: MachineryId): List<ServiceOperation>
  }

  class Notes <<Value Object>> {
    - value: String
  }

  class HoursWorked <<Value Object>> {
    - value: BigDecimal
    + add(other: HoursWorked): HoursWorked
    + isNonNegative(): Boolean
  }

  class WorkShift <<Value Object>> {
    - workDate: LocalDate
    - startTime: LocalTime
    - endTime: LocalTime
    + duration(): HoursWorked
  }

  package "Identifiers" {
    class MachineryId <<Value Object>> {
      - value: Long
    }
    class ProfileId <<Value Object>> {
      - value: Long
    }
    class RentalId <<Value Object>> {
      - value: Long
    }
    class ServiceOperationId <<Value Object>> {
      - value: Long
    }
    class WorkedHoursId <<Value Object>> {
      - value: Long
    }
  }
}

ServiceOperation "1" *-- "0..*" WorkedHours : records >
ServiceOperation --> OperationStatus : has >
WorkedHours --> WorkedHoursStatus : has >
OperationsManagementService "1" --> "1" ServiceOperationRepository : uses >
ServiceOperationRepository ..> ServiceOperation : persists >

WorkedHours "1" *-- "1" WorkShift : shift >
WorkedHours "1" *-- "1" HoursWorked : totalHours >
WorkedHours "1" *-- "1" Notes : observations >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
