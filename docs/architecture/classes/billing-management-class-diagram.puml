@startuml
title MaquiControl - Billing Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Billing Management" {

  class Invoice <<Aggregate Root>> {
    - id: InvoiceId
    - rentalId: RentalId
    - invoiceNumber: InvoiceNumber
    - sunatCdr: SunatCdr
    - amount: Money
    - status: InvoiceStatus
    - issuedAt: LocalDateTime
    + calculate(amount: Money): void
    + issue(invoiceNumber: InvoiceNumber, sunatCdr: SunatCdr): void
    + reject(reason: Reason): void
    + isIssued(): Boolean
  }

  class LatePenalty <<Aggregate Root>> {
    - id: LatePenaltyId
    - rentalId: RentalId
    - amount: Money
    - reason: Reason
    - appliedAt: LocalDateTime
    + apply(): void
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum InvoiceStatus {
    PENDING
    ISSUED
    REJECTED
  }

  interface InvoiceRepository {
    + save(invoice: Invoice): Invoice
    + findById(id: InvoiceId): Optional<Invoice>
    + findByRentalId(rentalId: RentalId): Optional<Invoice>
  }

  interface LatePenaltyRepository {
    + save(penalty: LatePenalty): LatePenalty
    + findByRentalId(rentalId: RentalId): List<LatePenalty>
  }

  class BillingManagementService <<Application Service>> {
    - invoiceRepository: InvoiceRepository
    - latePenaltyRepository: LatePenaltyRepository
    + calculateRentalAmount(rentalId: RentalId, amount: Money): Invoice
    + issueInvoice(invoiceId: InvoiceId, invoiceNumber: InvoiceNumber, sunatCdr: SunatCdr): Invoice
    + applyLatePenalty(rentalId: RentalId, amount: Money, reason: Reason): LatePenalty
    + viewInvoice(id: InvoiceId): Invoice
    + viewInvoiceHistory(rentalId: RentalId): List<Invoice>
    + viewLatePenaltiesByRental(rentalId: RentalId): List<LatePenalty>
  }

  class Reason <<Value Object>> {
    - value: String
  }

  class InvoiceNumber <<Value Object>> {
    - series: String
    - correlative: Integer
    + format(): String
  }

  class SunatCdr <<Value Object>> {
    - value: String
    + isAccepted(): Boolean
  }

  package "Identifiers" {
    class InvoiceId <<Value Object>> {
      - value: Long
    }
    class LatePenaltyId <<Value Object>> {
      - value: Long
    }
    class RentalId <<Value Object>> {
      - value: Long
    }
  }
}

Invoice "1" *-- "1" Money : amount >
LatePenalty "1" *-- "1" Money : amount >
Money --> Currency : expressed in >
Invoice --> InvoiceStatus : has >
BillingManagementService "1" --> "1" InvoiceRepository : uses >
BillingManagementService "1" --> "1" LatePenaltyRepository : uses >
InvoiceRepository ..> Invoice : persists >
LatePenaltyRepository ..> LatePenalty : persists >

Invoice "1" *-- "1" InvoiceNumber : invoiceNumber >
Invoice "1" *-- "1" SunatCdr : sunatCdr >
LatePenalty "1" *-- "1" Reason : reason >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
