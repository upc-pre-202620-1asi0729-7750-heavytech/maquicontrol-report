@startuml
title MaquiControl - Fleet Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Fleet Management" {

  class Machinery <<Aggregate Root>> {
    - id: MachineryId
    - ownerProfileId: ProfileId
    - categoryId: CategoryId
    - specification: MachinerySpecification
    - hourlyRate: Money
    - status: MachineryStatus
    - location: MachineryLocation
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    + register(): void
    + updateInformation(specification: MachinerySpecification, hourlyRate: Money): void
    + changeStatus(status: MachineryStatus): void
    + updateLocation(location: MachineryLocation): void
    + classifyAs(category: Category): void
    + isAvailable(): Boolean
  }

  class Category <<Entity>> {
    - id: CategoryId
    - code: CategoryCode
    - name: CategoryName
    - status: CategoryStatus
    + rename(name: CategoryName): void
    + deactivate(): void
  }

  class MachineryLocation <<Value Object>> {
    - department: String
    - province: String
    - district: String
    - address: String
    - latitude: Double
    - longitude: Double
    + fullAddress(): String
    + isValid(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + multiply(factor: BigDecimal): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum MachineryStatus {
    AVAILABLE
    RESERVED
    RENTED
    IN_MAINTENANCE
    OUT_OF_SERVICE
  }

  interface MachineryRepository {
    + save(machinery: Machinery): Machinery
    + findById(id: MachineryId): Optional<Machinery>
    + findAll(): List<Machinery>
    + findAvailable(): List<Machinery>
    + findByCategoryId(categoryId: CategoryId): List<Machinery>
    + existsById(id: MachineryId): Boolean
  }

  interface CategoryRepository {
    + save(category: Category): Category
    + findById(id: CategoryId): Optional<Category>
    + findAllActive(): List<Category>
    + existsById(id: CategoryId): Boolean
  }

  class FleetManagementService <<Application Service>> {
    - machineryRepository: MachineryRepository
    - categoryRepository: CategoryRepository
    + registerMachinery(machinery: Machinery): Machinery
    + updateMachineryInformation(id: MachineryId, specification: MachinerySpecification, hourlyRate: Money): Machinery
    + updateMachineryStatus(id: MachineryId, status: MachineryStatus): Machinery
    + registerCategory(category: Category): Category
    + updateCategory(id: CategoryId, name: CategoryName): Category
    + viewMachineryInventory(): List<Machinery>
    + viewCategories(): List<Category>
    + checkMachineryAvailability(id: MachineryId): Boolean
  }

  class MachinerySpecification <<Value Object>> {
    - name: String
    - brand: String
    - model: String
    - manufactureYear: Integer
    - description: String
    + isValidYear(): Boolean
  }

  class CategoryCode <<Value Object>> {
    - value: String
  }

  class CategoryName <<Value Object>> {
    - value: String
    + equalsIgnoreCase(other: CategoryName): Boolean
  }

  enum CategoryStatus {
    ACTIVE
    INACTIVE
  }

  package "Identifiers" {
    class CategoryId <<Value Object>> {
      - value: Long
    }
    class MachineryId <<Value Object>> {
      - value: Long
    }
    class ProfileId <<Value Object>> {
      - value: Long
    }
  }
}

Machinery "1" *-- "1" MachineryLocation : contains >
Machinery "1" *-- "1" Money : hourly rate >
Machinery "0..*" --> "1" Category : classified as >
Money --> Currency : expressed in >
Machinery --> MachineryStatus : has >
FleetManagementService "1" --> "1" MachineryRepository : uses >
FleetManagementService "1" --> "1" CategoryRepository : uses >
MachineryRepository ..> Machinery : persists >
CategoryRepository ..> Category : persists >

Machinery "1" *-- "1" MachinerySpecification : specification >
Category "1" *-- "1" CategoryCode : code >
Category "1" *-- "1" CategoryName : name >
Category --> CategoryStatus : status >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
