@startuml
title MaquiControl - Fleet Management Bounded Context\nGeneral Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Fleet Management" {

  class Machinery <<Aggregate Root>> {
    - id: MachineryId
    - ownerProfileId: ProfileId
    - categoryId: CategoryId
    - specification: MachinerySpecification
    - hourlyRate: Money
    - status: MachineryStatus
    - location: MachineryLocation
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    + update(specification: MachinerySpecification, hourlyRate: Money, location: MachineryLocation, category: Category): void
    + changeStatus(status: MachineryStatus): void
    + isAvailable(): Boolean
  }

  class Category <<Aggregate Root>> {
    - id: CategoryId
    - code: CategoryCode
    - name: CategoryName
    + rename(name: CategoryName): void
  }

  class MachineryLocation <<Value Object>> {
    - department: String
    - province: String
    - district: String
    - address: String
    - latitude: Double
    - longitude: Double
    + fullAddress(): String
    + isValid(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + multiply(factor: BigDecimal): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum MachineryStatus {
    AVAILABLE
    RESERVED
    RENTED
    IN_MAINTENANCE
    OUT_OF_SERVICE
  }

  interface MachineryRepository {
    + save(machinery: Machinery): Machinery
    + findById(id: MachineryId): Optional<Machinery>
    + findAll(): List<Machinery>
    + findAvailable(): List<Machinery>
    + findByCategoryId(categoryId: CategoryId): List<Machinery>
    + existsById(id: MachineryId): Boolean
  }

  interface CategoryRepository {
    + save(category: Category): Category
    + findById(id: CategoryId): Optional<Category>
    + findAll(): List<Category>
    + existsByName(name: CategoryName): Boolean
    + existsById(id: CategoryId): Boolean
  }

  class FleetManagementCommandService <<Application Service>> {
    - machineryRepository: MachineryRepository
    - categoryRepository: CategoryRepository
    + handle(command: RegisterMachineryCommand): Optional<Machinery>
    + handle(command: UpdateMachineryCommand): Optional<Machinery>
    + handle(command: ChangeMachineryStatusCommand): Optional<Machinery>
    + handle(command: DeleteMachineryCommand): void
    + handle(command: CreateCategoryCommand): Optional<Category>
    + handle(command: RenameCategoryCommand): Optional<Category>
    + handle(command: DeleteCategoryCommand): void
  }

  class FleetManagementQueryService <<Application Service>> {
    - machineryRepository: MachineryRepository
    - categoryRepository: CategoryRepository
    + handle(query: ViewMachineryCatalogQuery): List<Machinery>
    + handle(query: CheckMachineryAvailabilityQuery): Boolean
    + handle(query: ViewCategoriesQuery): List<Category>
  }

  package "Commands" {
    class RegisterMachineryCommand <<Command>> {
      - ownerProfileId: ProfileId
      - categoryId: CategoryId
      - specification: MachinerySpecification
      - hourlyRate: Money
      - location: MachineryLocation
    }
    class UpdateMachineryCommand <<Command>> {
      - machineryId: MachineryId
      - categoryId: CategoryId
      - specification: MachinerySpecification
      - hourlyRate: Money
      - location: MachineryLocation
    }
    class ChangeMachineryStatusCommand <<Command>> {
      - machineryId: MachineryId
      - status: MachineryStatus
    }
    class DeleteMachineryCommand <<Command>> {
      - machineryId: MachineryId
    }
    class CreateCategoryCommand <<Command>> {
      - name: CategoryName
    }
    class RenameCategoryCommand <<Command>> {
      - categoryId: CategoryId
      - name: CategoryName
    }
    class DeleteCategoryCommand <<Command>> {
      - categoryId: CategoryId
    }
  }

  package "Queries" {
    class ViewMachineryCatalogQuery <<Query>> {
      - categoryId: CategoryId [0..1]
    }
    class CheckMachineryAvailabilityQuery <<Query>> {
      - machineryId: MachineryId
    }
    class ViewCategoriesQuery <<Query>> {
    }
  }

  class MachinerySpecification <<Value Object>> {
    - name: String
    - brand: String
    - model: String
    - manufactureYear: Integer
    - description: String
    + isValidYear(): Boolean
  }

  class CategoryCode <<Value Object>> {
    - value: String
  }

  class CategoryName <<Value Object>> {
    - value: String
    + equalsIgnoreCase(other: CategoryName): Boolean
  }

  package "Identifiers" {
    class CategoryId <<Value Object>> {
      - value: Long
    }
    class MachineryId <<Value Object>> {
      - value: Long
    }
    class ProfileId <<Value Object>> {
      - value: Long
    }
  }
}

Machinery "1" *-- "1" MachineryLocation : contains >
Machinery "1" *-- "1" Money : hourly rate >
Machinery "0..*" --> "1" Category : classified as >
Money --> Currency : expressed in >
Machinery --> MachineryStatus : has >
FleetManagementCommandService "1" --> "1" MachineryRepository : uses >
FleetManagementQueryService "1" --> "1" MachineryRepository : uses >
FleetManagementCommandService "1" --> "1" CategoryRepository : uses >
FleetManagementQueryService "1" --> "1" CategoryRepository : uses >
MachineryRepository ..> Machinery : persists >
CategoryRepository ..> Category : persists >

Machinery "1" *-- "1" MachinerySpecification : specification >
Category "1" *-- "1" CategoryCode : code >
Category "1" *-- "1" CategoryName : name >

FleetManagementCommandService "1" ..> "1" RegisterMachineryCommand : handles >
FleetManagementCommandService "1" ..> "1" UpdateMachineryCommand : handles >
FleetManagementCommandService "1" ..> "1" ChangeMachineryStatusCommand : handles >
FleetManagementCommandService "1" ..> "1" DeleteMachineryCommand : handles >
FleetManagementCommandService "1" ..> "1" CreateCategoryCommand : handles >
FleetManagementCommandService "1" ..> "1" RenameCategoryCommand : handles >
FleetManagementCommandService "1" ..> "1" DeleteCategoryCommand : handles >
FleetManagementQueryService "1" ..> "1" ViewMachineryCatalogQuery : handles >
FleetManagementQueryService "1" ..> "1" CheckMachineryAvailabilityQuery : handles >
FleetManagementQueryService "1" ..> "1" ViewCategoriesQuery : handles >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend


@enduml
