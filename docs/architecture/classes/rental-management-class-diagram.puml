@startuml
title MaquiControl - Rental Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Rental Management" {

  class Rental <<Aggregate Root>> {
    - id: RentalId
    - machineryId: MachineryId
    - contractorProfileId: ProfileId
    - period: RentalPeriod
    - status: RentalStatus
    - totalAmount: Money
    - requestedAt: LocalDateTime
    - confirmedAt: LocalDateTime
    - cancelledAt: LocalDateTime
    - cancellationReason: Reason
    + confirm(): void
    + reject(reason: Reason): void
    + cancel(reason: Reason): void
    + start(): void
    + complete(): void
    + calculateTotal(hourlyRate: Money): Money
    + isActive(): Boolean
  }

  class RentalPeriod <<Value Object>> {
    - startDate: LocalDate
    - endDate: LocalDate
    + durationInDays(): Long
    + overlaps(other: RentalPeriod): Boolean
    + isValid(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + multiply(factor: BigDecimal): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum RentalStatus {
    REQUESTED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    REJECTED
    CANCELLED
  }

  interface RentalRepository {
    + save(rental: Rental): Rental
    + findById(id: RentalId): Optional<Rental>
    + findByContractorProfileId(profileId: ProfileId): List<Rental>
    + findByMachineryId(machineryId: MachineryId): List<Rental>
    + findByStatus(status: RentalStatus): List<Rental>
    + existsOverlappingRental(machineryId: MachineryId, period: RentalPeriod): Boolean
  }

  class RentalManagementCommandService <<Application Service>> {
    - rentalRepository: RentalRepository
    + handle(command: RequestRentalCommand): Optional<Rental>
    + handle(command: ConfirmReservationCommand): Optional<Rental>
    + handle(command: RejectReservationCommand): Optional<Rental>
    + handle(command: CancelReservationCommand): Optional<Rental>
    + handle(command: StartRentalCommand): Optional<Rental>
    + handle(command: CompleteRentalCommand): Optional<Rental>
  }

  class RentalManagementQueryService <<Application Service>> {
    - rentalRepository: RentalRepository
    + handle(query: ViewPendingRequestsQuery): List<Rental>
    + handle(query: ViewMyReservationsQuery): List<Rental>
    + handle(query: CheckMachineryAvailabilityQuery): Boolean
  }

  package "Commands" {
    class RequestRentalCommand <<Command>> {
      - machineryId: MachineryId
      - contractorProfileId: ProfileId
      - period: RentalPeriod
    }
    class ConfirmReservationCommand <<Command>> {
      - rentalId: RentalId
    }
    class RejectReservationCommand <<Command>> {
      - rentalId: RentalId
      - reason: Reason
    }
    class CancelReservationCommand <<Command>> {
      - rentalId: RentalId
      - reason: Reason
    }
    class StartRentalCommand <<Command>> {
      - rentalId: RentalId
    }
    class CompleteRentalCommand <<Command>> {
      - rentalId: RentalId
    }
  }

  package "Queries" {
    class ViewPendingRequestsQuery <<Query>> {
      - ownerProfileId: ProfileId
    }
    class ViewMyReservationsQuery <<Query>> {
      - contractorProfileId: ProfileId
    }
    class CheckMachineryAvailabilityQuery <<Query>> {
      - machineryId: MachineryId
      - period: RentalPeriod
    }
  }

  class Reason <<Value Object>> {
    - value: String
  }

  package "Identifiers" {
    class MachineryId <<Value Object>> {
      - value: Long
    }
    class ProfileId <<Value Object>> {
      - value: Long
    }
    class RentalId <<Value Object>> {
      - value: Long
    }
  }
}

Rental "1" *-- "1" RentalPeriod : contains >
Rental "1" *-- "1" Money : total >
Money --> Currency : expressed in >
Rental --> RentalStatus : has >
RentalManagementCommandService "1" --> "1" RentalRepository : uses >
RentalManagementQueryService "1" --> "1" RentalRepository : uses >
RentalRepository ..> Rental : persists >



RentalManagementCommandService "1" ..> "1" RequestRentalCommand : handles >
RentalManagementCommandService "1" ..> "1" ConfirmReservationCommand : handles >
RentalManagementCommandService "1" ..> "1" RejectReservationCommand : handles >
RentalManagementCommandService "1" ..> "1" CancelReservationCommand : handles >
RentalManagementCommandService "1" ..> "1" StartRentalCommand : handles >
RentalManagementCommandService "1" ..> "1" CompleteRentalCommand : handles >
RentalManagementQueryService "1" ..> "1" ViewPendingRequestsQuery : handles >
RentalManagementQueryService "1" ..> "1" ViewMyReservationsQuery : handles >
RentalManagementQueryService "1" ..> "1" CheckMachineryAvailabilityQuery : handles >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend


@enduml
